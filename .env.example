# Postgres 접속 정보 (권장: Neon — neon.tech, 무료 티어 / Vercel 대시보드에서
# "Storage" 탭으로 바로 연동 가능). 서버리스 환경에서는 Neon이 제공하는
# "Pooled connection" 문자열(호스트명에 -pooler가 붙은 형태)을 사용하세요.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# 자체 서명 인증서를 쓰는 DB에 접속할 때만 필요 (대부분은 지정하지 않아도 됩니다)
# DATABASE_SSL=false

# S3 호환 Object Storage (권장: Cloudflare R2 — 무료 티어 넉넉함, VPC/방화벽 설정 불필요)
# Cloudflare 대시보드 > R2 > 버킷 생성 > API 토큰(Access Key/Secret Key) 발급
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
S3_BUCKET=upmoo-submissions
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto

# 전체 관리자(admin) 페이지 접속 비밀번호
ADMIN_PASSWORD=change-me

# (선택, 권장) HWP 통합 다운로드를 실제 한글 프로그램으로 처리하는 Windows
# 폴링 워커 인증값. windows-hwp-service/README.md 참고. 워커 쪽 MERGE_SECRET과
# 동일한 값을 넣으세요. 설정 없이도 폴링 큐 자체는 동작하지만(워커가 그냥
# 인증 없이 접속), 외부에 노출되는 엔드포인트이니 운영에서는 꼭 설정하세요.
# HWP_MERGE_WORKER_SECRET=change-me

# (선택, 비권장) true로 설정하면 위 Windows 워커 대신 api/hwp_merge.py(HWP5
# 포맷을 직접 구현한 실험적 기능)를 바로 사용합니다. 실제 한글 프로그램의
# 비공개 내부 검증을 통과하지 못해 파일을 인식 못하는 사례가 확인됐습니다.
# HWP_MERGE_USE_EXPERIMENTAL_PYTHON=true
