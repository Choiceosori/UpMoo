# 네이버 클라우드 Cloud DB for PostgreSQL 접속 정보
# NCP 콘솔 > Cloud DB for PostgreSQL > 해당 DB 서버 > "공인 도메인"(Public Domain) 또는
# 공인 IP, 포트(기본 5432), DB 이름, 사용자, 비밀번호를 조합해 작성하세요.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DBNAME

# NCP Cloud DB for PostgreSQL은 자체 서명 인증서를 쓰는 경우가 많아 기본적으로
# 인증서 검증을 완화합니다. SSL을 아예 쓰지 않는 구성이라면 false로 설정하세요.
# DATABASE_SSL=false

# 네이버 클라우드 Object Storage (S3 호환 API)
# NCP 콘솔 > Object Storage > 인증키 관리에서 발급
NCP_ACCESS_KEY=YOUR_ACCESS_KEY
NCP_SECRET_KEY=YOUR_SECRET_KEY
NCP_STORAGE_BUCKET=upmoo-submissions
NCP_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_OBJECT_STORAGE_REGION=kr-standard

# 전체 관리자(admin) 페이지 접속 비밀번호
ADMIN_PASSWORD=change-me
